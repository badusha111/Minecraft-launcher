<Window x:Class="NexcraftLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXCRAFT Launcher" Width="1180" Height="720"
        MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="#F5F7FA">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C7CEDA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#202631"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#354252"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#19F58A"/>
                    <Setter Property="Foreground" Value="#071A12"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#202631"/>
            <Setter Property="BorderBrush" Value="#586477"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" CornerRadius="18" Background="#151922" BorderBrush="#303744" BorderThickness="1"/>
        <Grid Grid.Column="0" Margin="0,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                <Border Width="34" Height="34" CornerRadius="9" Background="#173C31" BorderBrush="#19F58A" BorderThickness="1">
                    <TextBlock Text="N" FontSize="22" FontWeight="Black" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NEXCRAFT" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="MINECRAFT LAUNCHER" FontSize="8" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="12,12,12,0">
                <Button Style="{StaticResource NavButton}" Background="#20352F" Foreground="{StaticResource GreenBrush}" Content="⌂   Главная"/>
                <Button Style="{StaticResource NavButton}" Content="◇   Моды и сборки" Click="Mods_Click"/>
                <Button Style="{StaticResource NavButton}" Content="▣   Библиотека" Click="Library_Click"/>
                <Button Style="{StaticResource NavButton}" Content="⚙   Настройки" Click="Settings_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="22,0">
                <TextBlock Text="NEXCRAFT PREVIEW" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="РАННЯЯ ВЕРСИЯ" FontSize="9" Foreground="{StaticResource OrangeBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1" Margin="0,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="26,0,26,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="ЦЕНТР ИГРЫ" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Лаунчер готов" Foreground="#E0E5ED" FontSize="12"/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,8,26,24">
                    <Border Height="320" CornerRadius="16" ClipToBounds="True" BorderBrush="#5B4B36" BorderThickness="1">
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#27384A" Offset="0"/>
                                    <GradientStop Color="#20243B" Offset="0.48"/>
                                    <GradientStop Color="#172C28" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Canvas IsHitTestVisible="False" Opacity="0.65">
                                <Polygon Points="390,35 470,10 530,62 480,105 410,90" Fill="#355D56"/>
                                <Polygon Points="390,35 410,90 480,105 470,70" Fill="#233F3A"/>
                                <Polygon Points="560,150 640,110 705,160 670,205 590,198" Fill="#3E6B5A"/>
                                <Polygon Points="560,150 590,198 670,205 650,170" Fill="#24463B"/>
                                <Polygon Points="300,210 350,180 410,220 385,255 320,252" Fill="#354D68"/>
                                <Polygon Points="300,210 320,252 385,255 365,225" Fill="#222E44"/>
                                <Ellipse Canvas.Left="430" Canvas.Top="110" Width="92" Height="92" Fill="#6B4DFF" Opacity="0.13"/>
                                <Ellipse Canvas.Left="450" Canvas.Top="130" Width="50" Height="50" Fill="#19F58A" Opacity="0.15"/>
                                <Line X1="430" Y1="160" X2="490" Y2="220" Stroke="#19F58A" StrokeThickness="2" Opacity="0.8"/>
                                <Line X1="490" Y1="160" X2="430" Y2="220" Stroke="#FF9D45" StrokeThickness="2" Opacity="0.8"/>
                            </Canvas>
                            <Border HorizontalAlignment="Left" Width="8" Background="{StaticResource OrangeBrush}" Opacity="0.85"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="34,0,0,0" MaxWidth="470">
                                <Border Background="#1B2029" CornerRadius="4" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,15">
                                    <TextBlock Text="НОВОЕ ПРИКЛЮЧЕНИЕ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                                </Border>
                                <TextBlock Text="ТВОЙ МИР." FontSize="39" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="ТВОИ ПРАВИЛА." FontSize="39" FontWeight="Black" Foreground="{StaticResource GreenBrush}"/>
                                <TextBlock Text="Подготовься к игре — остальное впереди." FontSize="14" Foreground="#E2E7EF" Margin="0,10,0,0"/>
                            </StackPanel>
                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,20,0" BorderBrush="#687588" BorderThickness="1" Background="#70202731" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="JAVA EDITION" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock Text="NEXCRAFT  /  SEASON 01" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,22,18" FontSize="10" Foreground="#D2D9E4"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20" Margin="0,0,16,0" BorderBrush="#303744" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ГОТОВ К ЗАПУСКУ?" FontSize="11" Foreground="#C0C8D5"/>
                                <TextBlock Text="Выбери версию Minecraft" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,16"/>
                                <ComboBox x:Name="VersionSelector" Height="40" SelectedIndex="0">
                                    <ComboBoxItem Content="1.21.1 — Vanilla"/>
                                    <ComboBoxItem Content="1.20.1 — Vanilla"/>
                                    <ComboBoxItem Content="1.16.5 — Vanilla"/>
                                </ComboBox>
                                <TextBlock x:Name="StatusText" Text="Выбери версию и нажми «ИГРАТЬ», чтобы загрузить игровые файлы." TextWrapping="Wrap" Foreground="#D0D7E2" FontSize="12" Margin="0,12,0,0"/>
                                <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Background="#252B35" Foreground="{StaticResource GreenBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <Border Background="#1A2825" BorderBrush="#28644A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="СЕРВЕРНАЯ СБОРКА" FontSize="10" Foreground="{StaticResource GreenBrush}"/>
                                    <TextBlock Text="Моды — скоро" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <TextBlock Text="Подготовим автоматическую установку и обновление модов." TextWrapping="Wrap" Foreground="#D0D8E0" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="PlayButton" Height="66" Background="{StaticResource GreenBrush}" Foreground="#092318" BorderThickness="0" FontSize="25" FontWeight="Black" Content="▶  ИГРАТЬ" Cursor="Hand" Click="Play_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                            </Button>
                            <TextBlock Text="ПЕРВАЯ УСТАНОВКА СКАЧАЕТ ФАЙЛЫ ИГРЫ" TextAlignment="Center" TextWrapping="Wrap" Foreground="#C0C8D5" FontSize="10" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>