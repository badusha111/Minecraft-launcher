<Window x:Class="NexcraftLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXCRAFT Launcher" Width="1280" Height="780"
        MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="#F5F7FA">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C7CEDA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252B39"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#51427D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#34274F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#202631"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#354252"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#19F58A"/>
                    <Setter Property="Foreground" Value="#071A12"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#FFB86B"/>
            <Setter Property="Background" Value="#202631"/>
            <Setter Property="BorderBrush" Value="#8B6BFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" CornerRadius="18" Background="#0C1222" BorderBrush="#34365D" BorderThickness="1"/>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                <Border Width="34" Height="34" CornerRadius="9" Background="#173C31" BorderBrush="#19F58A" BorderThickness="1">
                    <TextBlock Text="N" FontSize="22" FontWeight="Black" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="NEXCRAFT" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="MINECRAFT LAUNCHER" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="12,12,12,0">
                <Button x:Name="HomeNavButton" Style="{StaticResource NavButton}" Background="#382078" Foreground="#DCCBFF" Content="⌂   Главная" Click="Home_Click"/>
                <Button x:Name="ModsNavButton" Style="{StaticResource NavButton}" Content="◇   Моды и сборки" Click="Mods_Click"/>
                <Button x:Name="LibraryNavButton" Style="{StaticResource NavButton}" Content="▣   Библиотека" Click="Library_Click"/>
                <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Content="⚙   Настройки" Click="Settings_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="22,0">
                <TextBlock Text="NEXCRAFT PREVIEW" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="РАННЯЯ ВЕРСИЯ" FontSize="9" Foreground="{StaticResource OrangeBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="26,0,26,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NEXCRAFT" Foreground="#F5F7FA" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Width="1" Height="24" Background="#8B5CF6" Margin="14,0"/>
                    <TextBlock Text="Официальный лаунчер МЕХМАТА" Foreground="#C084FC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="Готов к входу" Foreground="#E0E5ED" FontSize="12"/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer x:Name="HomeScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,8,26,24">
                    <Border Height="270" CornerRadius="16" ClipToBounds="True" BorderBrush="#5B4B36" BorderThickness="1">
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#211447" Offset="0"/>
                                    <GradientStop Color="#171A35" Offset="0.48"/>
                                    <GradientStop Color="#102B32" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Canvas IsHitTestVisible="False" Opacity="0.65">
                                <Rectangle Canvas.Left="350" Canvas.Top="26" Width="54" Height="12" Fill="#C8C8FF" Opacity="0.25"/>
                                <Rectangle Canvas.Left="376" Canvas.Top="14" Width="76" Height="12" Fill="#C8C8FF" Opacity="0.25"/>
                                <Rectangle Canvas.Left="402" Canvas.Top="26" Width="42" Height="12" Fill="#C8C8FF" Opacity="0.25"/>
                                <Ellipse Canvas.Left="590" Canvas.Top="26" Width="58" Height="58" Fill="#FFCB77" Opacity="0.85"/>
                                <Polygon Points="300,178 420,70 525,178" Fill="#4A527B"/>
                                <Polygon Points="420,70 455,108 434,102 415,126 396,112 378,134" Fill="#D7D9F2" Opacity="0.8"/>
                                <Polygon Points="400,185 520,90 635,185" Fill="#35436A"/>
                                <Polygon Points="520,90 548,114 530,110 516,128 497,117" Fill="#B7BDE1" Opacity="0.7"/>
                                <Polygon Points="280,215 430,135 545,215" Fill="#282F52"/>
                                <Polygon Points="450,218 585,128 735,218" Fill="#273A4D"/>
                                <Polygon Points="450,218 585,128 735,218 735,258 450,258" Fill="#315C50"/>
                                <Polygon Points="450,218 585,128 735,218" Fill="#46755C"/>
                                <Polygon Points="450,218 735,218 735,258 450,258" Fill="#25473E"/>
                                <Rectangle Canvas.Left="465" Canvas.Top="223" Width="240" Height="8" Fill="#5B8D62"/>
                                <Rectangle Canvas.Left="480" Canvas.Top="231" Width="225" Height="8" Fill="#24483E"/>
                                <Rectangle Canvas.Left="520" Canvas.Top="205" Width="14" Height="30" Fill="#6B4938"/>
                                <Rectangle Canvas.Left="506" Canvas.Top="188" Width="42" Height="22" Fill="#3E8A51"/>
                                <Rectangle Canvas.Left="514" Canvas.Top="176" Width="26" Height="15" Fill="#4B9B59"/>
                                <Rectangle Canvas.Left="585" Canvas.Top="213" Width="12" Height="24" Fill="#6B4938"/>
                                <Rectangle Canvas.Left="571" Canvas.Top="198" Width="40" Height="21" Fill="#347849"/>
                                <Rectangle Canvas.Left="579" Canvas.Top="186" Width="24" Height="15" Fill="#4A9654"/>
                                <Rectangle Canvas.Left="628" Canvas.Top="218" Width="10" Height="22" Fill="#6B4938"/>
                                <Rectangle Canvas.Left="616" Canvas.Top="202" Width="34" Height="19" Fill="#367B49"/>
                                <Rectangle Canvas.Left="622" Canvas.Top="191" Width="22" Height="13" Fill="#4B9B59"/>
                                <Polygon Points="300,210 350,180 410,220 385,255 320,252" Fill="#354D68"/>
                                <Polygon Points="300,210 320,252 385,255 365,225" Fill="#222E44"/>
                                <Ellipse Canvas.Left="430" Canvas.Top="110" Width="92" Height="92" Fill="#6B4DFF" Opacity="0.10"/>
                                <Ellipse Canvas.Left="450" Canvas.Top="130" Width="50" Height="50" Fill="#19F58A" Opacity="0.10"/>
                            </Canvas>
                            <Border HorizontalAlignment="Left" Width="8" Background="#8B5CF6" Opacity="0.85"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="34,0,0,0" MaxWidth="470">
                                <Border Background="#1B2029" CornerRadius="4" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,15">
                                    <TextBlock Text="NEXCRAFT — ЭТО НЕ ПРОСТО ЛАУНЧЕР" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/>
                                </Border>
                                <TextBlock Text="ТВОЙ МИР." FontSize="39" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="ТВОИ ПРАВИЛА." FontSize="39" FontWeight="Black" Foreground="#B45CFF"/>
                                <TextBlock Text="Это твой мир, твои правила." FontSize="14" Foreground="#E2E7EF" Margin="0,10,0,0"/>
                            </StackPanel>
                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,20,20,0" BorderBrush="#687588" BorderThickness="1" Background="#70202731" CornerRadius="8" Padding="12,8">
                                <TextBlock Text="JAVA EDITION" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock Text="NEXCRAFT  /  SEASON 01" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,22,18" FontSize="10" Foreground="#D2D9E4"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20" Margin="0,0,16,0" BorderBrush="#303744" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ТВОЙ ПРОФИЛЬ" FontSize="11" Foreground="#B99AFF"/>
                                <TextBlock Text="Запуск Minecraft" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,12" Foreground="#F5F7FA"/>
                                <TextBlock Text="Твой игровой ник" FontSize="12" Foreground="#D0D7E2" Margin="0,0,0,7"/>
                                <TextBox x:Name="PlayerNicknameTextBox" Height="40" Padding="10,8" FontSize="14" Background="#202631" Foreground="#FFFFFF" BorderBrush="#586477" BorderThickness="1" MaxLength="16" ToolTip="3–16 символов: A–Z, 0–9 и подчёркивание"/>
                                <Grid Margin="0,16,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="ВЕРСИЯ MINECRAFT" FontSize="12" FontWeight="Bold" Foreground="#B99AFF" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#29213D" BorderBrush="#6B4DFF" BorderThickness="1" CornerRadius="6" Padding="7,3">
                                        <TextBlock Text="JAVA" FontSize="9" FontWeight="Bold" Foreground="#D9CCFF"/>
                                    </Border>
                                </Grid>
                                <ComboBox x:Name="VersionSelector" Height="42" SelectedIndex="0" IsTextSearchEnabled="True" ToolTip="Выбери версию Minecraft Java Edition"/>
                                <TextBlock Text="ЗАГРУЗЧИК" FontSize="11" FontWeight="Bold" Foreground="#B99AFF" Margin="0,12,0,6"/>
                                <ComboBox x:Name="LoaderSelector" Height="40" SelectedIndex="0" ToolTip="Vanilla — без модов; Fabric и Forge — загрузчики модов">
                                    <ComboBoxItem Content="Vanilla — обычная игра"/>
                                    <ComboBoxItem Content="Fabric — лёгкий загрузчик модов"/>
                                    <ComboBoxItem Content="Forge — загрузчик модов"/>
                                </ComboBox>
                                <TextBlock x:Name="VersionInfoText" Text="Доступные версии появятся после загрузки официального списка." TextWrapping="Wrap" Foreground="#AEB8C8" FontSize="11" Margin="0,7,0,0"/>
                                <TextBlock x:Name="StatusText" Text="Выбери версию и нажми «ИГРАТЬ», чтобы загрузить игровые файлы." TextWrapping="Wrap" Foreground="#D0D7E2" FontSize="12" Margin="0,12,0,0"/>
                                <ProgressBar x:Name="DownloadProgress" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Background="#252B35" Foreground="{StaticResource GreenBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <Border Background="#171B2B" BorderBrush="#3A315E" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="ИГРОВОЙ ПРОФИЛЬ" FontSize="10" Foreground="#C084FC" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="54" Height="54" Margin="0,0,12,0">
                                            <Border Background="#35245B" CornerRadius="8"/>
                                            <Rectangle Width="20" Height="20" Fill="#E5B18B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                            <Rectangle Width="24" Height="8" Fill="#5A372B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                            <Rectangle Width="30" Height="17" Fill="#6D5BEA" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                            <Rectangle Width="4" Height="4" Fill="#202631" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ИГРОК NEXCRAFT" FontSize="12" FontWeight="Bold" Foreground="#F5F7FA"/>
                                            <TextBlock Text="Java Edition" FontSize="11" Foreground="#AEB8C8" Margin="0,4,0,0"/>
                                            <TextBlock Text="Профиль запуска" FontSize="10" Foreground="#19F58A" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A2825" BorderBrush="#28644A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="СЕРВЕРНАЯ СБОРКА" FontSize="10" Foreground="{StaticResource GreenBrush}"/>
                                    <TextBlock Text="Моды — скоро" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <TextBlock Text="Подготовим автоматическую установку и обновление модов." TextWrapping="Wrap" Foreground="#D0D8E0" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="PlayButton" Height="66" Background="{StaticResource GreenBrush}" Foreground="#092318" BorderThickness="0" FontSize="25" FontWeight="Black" Content="ИГРАТЬ" Cursor="Hand" Click="Play_Click">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                            </Button>
                            <TextBlock Text="ПЕРВАЯ УСТАНОВКА СКАЧАЕТ ФАЙЛЫ ИГРЫ" TextAlignment="Center" TextWrapping="Wrap" Foreground="#C0C8D5" FontSize="10" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SectionScrollViewer" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SectionContent" Margin="26,8,26,24"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>