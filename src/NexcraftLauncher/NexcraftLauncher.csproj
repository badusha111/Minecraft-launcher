<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NexcraftLauncher</RootNamespace>
    <AssemblyName>NEXCRAFT</AssemblyName>
    <ApplicationIcon>Nexcraft.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
